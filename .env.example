DISCORD_TOKEN=YOUR_BOT_TOKEN
CLIENT_ID=YOUR_CLIENT_ID
GUILD_ID=YOUR_GUILD_ID
CLIENT_SECRET=YOUR_CLIENT_SECRET
SESSION_SECRET=CHANGE_ME

# Public URL this app is reachable at (no trailing slash). Used to build the
# Discord OAuth2 redirect URI: <APP_BASE_URL>/auth/callback
# Must also be registered in the Discord Developer Portal under
# OAuth2 -> Redirects for the exact same URL.
# Local dev example: http://localhost:3000
# Railway example:   https://yourapp.up.railway.app
APP_BASE_URL=http://localhost:3000

# NOTE: admin role is NOT set here — it's per-guild, configured via the
# /setup-payment command or the dashboard Settings page (stored in the
# `settings` table). This env var is intentionally unused; ManageGuild
# permission always works as a fallback admin check regardless.

PORT=3000

# Auto-set by Railway when a Volume is attached to this service — DO NOT set
# this manually for local dev. When present, the DB file and uploads/ (vip
# files, transcripts, backups) are stored here instead of the project root,
# so they survive redeploys. See KNOWN_ISSUES.md for how to attach a Volume.
# RAILWAY_VOLUME_MOUNT_PATH=/data
